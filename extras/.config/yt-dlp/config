# vim:ft=conf
--verbose
--no-warnings
--progress
--windows-filenames

-f 'bestaudio[ext=m4a]/bestaudio'
--audio-quality 0
--extract-audio

--progress-delta .75
-t sleep
--no-mtime
--no-embed-info-json

--ffmpeg-location /usr/bin/ffmpeg
--js-runtimes "deno:$HOME/.local/share/mise/installs/deno/latest/bin/deno"
--js-runtimes "node:$HOME/.local/share/mise/installs/node/latest/bin/node"
--js-runtimes 'bun:/home/linuxbrew/.linuxbrew/bin/bun'

--paths "$HOME/Downloads/yt-dlp"
--paths "temp:$HOME/Downloads/yt-dlp"
-o '%(album,playlist_title)s/%(artists)s - %(title)s [%(id)s].%(ext)s'

--write-thumbnail
--convert-thumbnails jpg
--ppa "ThumbnailsConvertor+ffmpeg_o:-c:v mjpeg -vf crop=\"'if(gt(ih,iw),iw,ih)':'if(gt(iw,ih),ih,iw)'\""
--embed-thumbnail

--embed-metadata

--force-overwrites
